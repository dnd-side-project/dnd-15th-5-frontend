{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://chapchap.kr/api",
        "EXPO_PUBLIC_WEB_URL": "https://chapchap.kr/"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://chapchap.kr/api",
        "EXPO_PUBLIC_WEB_URL": "https://chapchap.kr/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
