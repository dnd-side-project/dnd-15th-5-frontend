{
  "expo": {
    "name": "ChapChap",
    "slug": "chapchap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chapchap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "kr.chapchap.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kr.chapchap.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "ChapChap이 리포트 이미지를 사진 보관함에 저장하도록 허용해 주세요.",
          "granularPermissions": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ChapChap이 영수증을 촬영하도록 카메라 접근을 허용해 주세요.",
          "microphonePermission": "ChapChap은 마이크를 사용하지 않습니다.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ChapChap이 영수증 사진을 선택하도록 사진 보관함 접근을 허용해 주세요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/pretendard/dist/public/static/alternative/Pretendard-Regular.ttf",
            "./node_modules/pretendard/dist/public/static/alternative/Pretendard-Medium.ttf",
            "./node_modules/pretendard/dist/public/static/alternative/Pretendard-SemiBold.ttf",
            "./node_modules/pretendard/dist/public/static/alternative/Pretendard-Bold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c7b88d4e-40e2-468d-8ac7-b23aab80bd9d"
      }
    }
  }
}
