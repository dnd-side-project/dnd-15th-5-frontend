{
  "specUrl": "https://chapchap.kr/api/v3/api-docs",
  "features": {
    "auth": {
      "tags": ["Authentication", "Social OAuth"],
      "operationIds": [
        "refreshApp",
        "refreshWeb",
        "exchangeSocialLoginCode",
        "agree",
        "logoutApp",
        "logoutWeb",
        "start",
        "callback"
      ]
    },
    "map": {
      "tags": ["Consumption", "Recommendation", "Place"],
      "operationIds": ["getVisitedPlaceMarkers", "getNearbyPlaces", "toggleLike"]
    },
    "myPage": {
      "directory": "my-page",
      "tags": ["Account"],
      "operationIds": ["getMyAccount", "updateMyAccount", "withdrawMyAccount"]
    },
    "notification": {
      "tags": ["notification-controller", "Account"],
      "operationIds": [
        "unregisterDeviceToken",
        "registerDeviceToken",
        "getNotifications",
        "hasUnread"
      ]
    },
    "record": {
      "tags": ["Consumption"],
      "operationIds": ["createConsumption", "recognizeReceipt"]
    },
    "report": {
      "tags": ["Consumption", "Report"],
      "operationIds": [
        "aggregateMonthlyReport",
        "getMonthlyReport",
        "getCurrentStatus",
        "getConsumptions",
        "getFrequentPlaces",
        "issueShareLink",
        "getSharedPersonaCard"
      ]
    },
    "shop": {
      "tags": ["Consumption", "Place"],
      "operationIds": ["getPlaceDetail", "getPlaceVisits", "searchVisitedPlaces"]
    }
  }
}
